# Copy this file to .env and fill in what you use. Never commit .env.

# --- Clip selection (optional but much better) ---
# With a key, Claude reads the transcript and picks the viral moments + writes captions.
# Without it, a loudness/speech heuristic picks the moments.
ANTHROPIC_API_KEY=

# --- Clip settings ---
CLIPS_PER_VIDEO=3
CLIP_MIN_SECONDS=20
CLIP_MAX_SECONDS=55
WHISPER_MODEL=small          # tiny / base / small / medium / large-v3 (bigger = better + slower)
CAPTION_FONT=Arial Black     # any font installed on your computer
DEFAULT_HASHTAGS="#viral #fyp #reels #shorts"
# If YouTube says "Sign in to confirm you're not a bot", set your browser: chrome / firefox / edge / safari
YTDLP_COOKIES_FROM_BROWSER=

# --- Instagram (Instagram API with Instagram Login, Business/Creator account) ---
IG_ACCESS_TOKEN=
IG_USER_ID=                  # optional, looked up automatically
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=         # must match the redirect URI registered in your TikTok app
# draft  = video lands in your TikTok inbox, you tap Post (works before TikTok audits your app)
# direct = posts straight away (needs an audited app; unaudited apps can only post as private)
TIKTOK_MODE=draft
TIKTOK_PRIVACY=SELF_ONLY     # for direct mode: PUBLIC_TO_EVERYONE once your app is audited
