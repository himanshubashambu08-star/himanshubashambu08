{
  "hosting": {
    "public": "petrol-receipts",
    "ignore": [
      "README.md",
      "firestore.rules",
      "**/.*"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/s/:tok",
        "destination": "https://firestore.googleapis.com/v1/projects/recite-66f60/databases/(default)/documents/gateStatus/:tok?mask.fieldPaths=state",
        "type": 302
      }
    ]
  }
}
