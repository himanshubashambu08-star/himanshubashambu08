# ---------------------------------------------------------------
# Gold Alerts — copy this file to .env and fill it in.
#   cp .env.example .env
# ---------------------------------------------------------------

# Your MAIN personal WhatsApp number. Alerts go here, and only this number
# can send commands. International format, digits only (Canada/US: 1 + 10 digits).
MY_WHATSAPP_NUMBER=1XXXXXXXXXX

# Optional: the BOT's own (extra) number. If set, the bot prints an 8-character
# pairing code instead of a QR (handy on a VPS where QR codes render badly).
# BOT_PAIRING_NUMBER=1XXXXXXXXXX

# Claude API key (https://console.anthropic.com). Required for the AI analysis.
ANTHROPIC_API_KEY=
# Model used to analyze each item. Haiku is fast and cheap.
ANTHROPIC_MODEL=claude-haiku-5-5

# Optional: Finnhub free API key (https://finnhub.io/register). Adds general + forex news.
FINNHUB_API_KEY=

# X (Twitter) accounts — OFF by default because the official X API is paid.
# Turn on only if you run an RSS bridge (self-hosted Nitter / RSSHub). Accounts live in
# config/social-accounts.json; {handle} is replaced with each account's handle.
ENABLE_X=false
# X_RSS_URL_TEMPLATE=https://nitter.example.com/{handle}/rss

# Your time zone (London, Ontario = America/Toronto).
TIMEZONE=America/Toronto

# How often to check news sources (seconds). 60 = alerts arrive within about a minute.
NEWS_POLL_SECONDS=60
# Medium-impact digest interval (minutes).
DIGEST_INTERVAL_MINUTES=30
# No medium digests during these hours (🚨 high-impact alerts still come through).
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00
# Morning briefing, and Sunday weekly outlook (24h, Toronto time).
BRIEFING_TIME=07:00
WEEKLY_OUTLOOK_TIME=18:00

# Minimum gap between WhatsApp messages (ms). Keep >= 5000 to protect the bot account.
SEND_INTERVAL_MS=5000
# Ignore items older than this when first seen (minutes).
MAX_ITEM_AGE_MINUTES=90
# Headline similarity (0-1) above which two items count as the same story.
DUPLICATE_SIMILARITY=0.5
# How often to refresh the ForexFactory calendar (minutes). Don't go below 10: the feed throttles.
CALENDAR_SYNC_MINUTES=15

# true = print messages in the terminal instead of sending to WhatsApp (for testing).
DRY_RUN=false
LOG_LEVEL=info
# DATA_DIR=./data          # SQLite DB + WhatsApp session
# CONFIG_DIR=./config      # feeds.json, social-accounts.json, cme-holidays.json
