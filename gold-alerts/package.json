{
  "name": "gold-alerts",
  "version": "1.0.0",
  "description": "24/7 gold (XAUUSD) news & event monitor with Hinglish WhatsApp alerts",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:source": "tsx scripts/test-source.ts",
    "pair": "tsx src/index.ts --pair-only"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^18.0.10",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "pino": "^10.4.0",
    "qrcode-terminal": "^0.12.0",
    "rss-parser": "^3.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.11",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
