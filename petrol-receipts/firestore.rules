rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write only their own data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Trade Gate lock status for the iPhone Shortcut: anyone with the secret
    // link can read one doc (no listing); only its owner can write it.
    match /gateStatus/{token} {
      allow get: if true;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
