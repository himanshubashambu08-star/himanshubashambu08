# Copy to .env and fill in. Never commit .env.

# Claude (analysis + follow-up chat)
ANTHROPIC_API_KEY=
# Optional override; default is claude-opus-5-5
# CLAUDE_MODEL=claude-opus-5-5

# OpenAI Whisper (speech to text)
OPENAI_API_KEY=
# Optional: whisper-1 (default) or gpt-4o-transcribe
# WHISPER_MODEL=whisper-1

# Instagram often needs a logged-in session. Export cookies from your browser
# (Netscape cookies.txt format) and point to the file:
# YTDLP_COOKIES_FILE=/path/to/cookies.txt
# ...or let yt-dlp read them straight from a local browser profile:
# YTDLP_COOKIES_FROM_BROWSER=chrome

# Where videos, frames and the SQLite database live (default: reel-analyzer/data)
# DATA_DIR=

# Max upload size in MB (default 200)
# MAX_UPLOAD_MB=200
