{
  "manifest_version": 3,
  "name": "Video Auto Translator",
  "short_name": "VidTranslate",
  "version": "1.0.0",
  "description": "Kisi bhi website par video ki language auto-detect karke usse aapki pasand ki language mein live subtitles / voice mein chalata hai.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Video Auto Translator",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/lang.js", "src/services.js", "src/background.js"]
  },
  "permissions": ["storage", "activeTab", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lang.js", "src/content.js"],
      "css": ["src/content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "video-auto-translator@example.com",
      "strict_min_version": "121.0"
    }
  }
}
